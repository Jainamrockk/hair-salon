# Neon Postgres connection string (Vercel → Storage → Neon, or console.neon.tech → Connection string).
# Without it the site runs on an embedded demo Postgres (PGlite) that resets on every cold start.
DATABASE_URL=

# Owner app password (/owner). Default in demo: salonche
OWNER_PASSWORD=
# Random long string used to sign login cookies
SESSION_SECRET=

# Show "Add-on · $X" price tags on features (true while the client reviews the proposal)
NEXT_PUBLIC_SHOW_PRICE_TAGS=true

# --- Paid add-ons (optional; demo mode without them) ---
# Photo-real AI try-on (Google Gemini image editing): aistudio.google.com → Get API key
GEMINI_API_KEY=
# optional: GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   TRYON_LIMIT_PER_10MIN=12
# AI assistant (Claude)
ANTHROPIC_API_KEY=
# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Payments (Stripe)
STRIPE_SECRET_KEY=
